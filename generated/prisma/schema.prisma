generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id            String?             @db.Uuid
  user_id               String?             @db.Uuid
  raw_input             String
  normalized_address    Json?
  verification_provider String?
  verification_status   String?
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  screening_sessions    screening_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?              @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model ai_conversations {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id              String?             @db.Uuid
  user_id                 String?             @db.Uuid
  language_code           String?             @default("en")
  human_handoff_requested Boolean             @default(false)
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  languages               languages?          @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions      screening_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                   users?              @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  ai_messages             ai_messages[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_messages {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id  String           @db.Uuid
  role             String
  content          String
  citations        Json?            @default("[]")
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  ai_conversations ai_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model answer_option_translations {
  option_id      String         @db.Uuid
  language_code  String
  label          String
  languages      languages      @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  answer_options answer_options @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([option_id, language_code])
}

model answer_options {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id                String                       @db.Uuid
  option_key                 String
  value                      Json
  display_order              Int
  answer_option_translations answer_option_translations[]
  questions                  questions                    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([question_id, option_key])
}

model audit_logs {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id      String?             @db.Uuid
  session_id         String?             @db.Uuid
  action             String
  entity_type        String
  entity_id          String?             @db.Uuid
  before_value       Json?
  after_value        Json?
  ip_address         String?             @db.Inet
  user_agent         String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  users              users?              @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions? @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_audit_logs_actor")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

model benefit_estimates {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String             @db.Uuid
  program_id          String             @db.Uuid
  min_amount          Decimal?           @db.Decimal(10, 2)
  max_amount          Decimal?           @db.Decimal(10, 2)
  period              String?
  disclaimer          String             @default("Estimate only. Final benefit amount is determined by the administering agency.")
  calculation_details Json?              @default("{}")
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  programs            programs           @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions  screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model case_notes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id     String   @db.Uuid
  author_id   String?  @db.Uuid
  note        String
  is_internal Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cases       cases    @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cases {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String             @db.Uuid
  assigned_to        String?            @db.Uuid
  status             case_status        @default(new)
  priority           case_priority?     @default(normal)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  case_notes         case_notes[]
  users              users?             @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model document_type_translations {
  document_type_id String         @db.Uuid
  language_code    String
  name             String
  description      String?
  examples         String?
  document_types   document_types @relation(fields: [document_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  languages        languages      @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([document_type_id, language_code])
}

model document_types {
  id                              String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_key                         String                          @unique
  category                        String
  document_classifications        document_classifications[]
  document_type_translations      document_type_translations[]
  document_uploads_confirmed_type document_uploads[]              @relation("document_uploads_confirmed_type")
  document_uploads_predicted_type document_uploads[]              @relation("document_uploads_predicted_type")
  program_document_requirements   program_document_requirements[]
  session_document_checklist      session_document_checklist[]
}

model document_uploads {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id                 String                     @db.Uuid
  document_type_id           String?                    @db.Uuid
  predicted_document_type_id String?                    @db.Uuid
  classification_confidence  Decimal?                   @db.Decimal(4, 3)
  classified_by              classification_source?
  classified_at              DateTime?                  @db.Timestamptz(6)
  file_name                  String
  file_mime_type             String
  storage_url                String
  status                     upload_status              @default(uploaded)
  ocr_text                   String?
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  document_classifications   document_classifications[]
  document_types             document_types?            @relation("document_uploads_confirmed_type", fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  predicted_document_type    document_types?            @relation("document_uploads_predicted_type", fields: [predicted_document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions         screening_sessions         @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model eligibility_results {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id                String                    @db.Uuid
  program_id                String                    @db.Uuid
  rule_version_id           String                    @db.Uuid
  outcome                   eligibility_outcome
  priority_rank             Int
  explanation               Json
  created_at                DateTime                  @default(now()) @db.Timestamptz(6)
  programs                  programs                  @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eligibility_rule_versions eligibility_rule_versions @relation(fields: [rule_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions        screening_sessions        @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, program_id])
  @@index([session_id], map: "idx_results_session")
}

model eligibility_rule_versions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id          String                @db.Uuid
  version             Int
  rules_json          Json
  false_positive_bias Boolean               @default(true)
  effective_from      DateTime              @db.Date
  effective_to        DateTime?             @db.Date
  created_by          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  eligibility_results eligibility_results[]
  users               users?                @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs            programs              @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([program_id, version])
  @@index([program_id], map: "idx_rule_versions_program")
  @@index([rules_json], map: "idx_rule_versions_rules", type: Gin)
}

model knowledge_sources {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id    String?    @db.Uuid
  title         String
  source_url    String
  language_code String?    @default("en")
  content_text  String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  languages     languages? @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  programs      programs?  @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model languages {
  code                       String                       @id
  name                       String
  ai_conversations           ai_conversations[]
  answer_option_translations answer_option_translations[]
  document_type_translations document_type_translations[]
  knowledge_sources          knowledge_sources[]
  life_event_translations    life_event_translations[]
  notification_preferences   notification_preferences[]
  program_translations       program_translations[]
  question_translations      question_translations[]
  screening_sessions         screening_sessions[]
  search_embeddings          search_embeddings[]
  search_queries             search_queries[]
  search_synonyms            search_synonyms[]
  users                      users[]
}

model life_event_translations {
  life_event_id String      @db.Uuid
  language_code String
  label         String
  languages     languages   @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  life_events   life_events @relation(fields: [life_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([life_event_id, language_code])
}

model life_events {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_key               String                    @unique
  life_event_translations life_event_translations[]
  program_life_events     program_life_events[]
}

model navigator_clients {
  navigator_user_id                                String    @db.Uuid
  client_user_id                                   String    @db.Uuid
  consent_granted_at                               DateTime  @default(now()) @db.Timestamptz(6)
  consent_revoked_at                               DateTime? @db.Timestamptz(6)
  users_navigator_clients_client_user_idTousers    users     @relation("navigator_clients_client_user_idTousers", fields: [client_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_navigator_clients_navigator_user_idTousers users     @relation("navigator_clients_navigator_user_idTousers", fields: [navigator_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([navigator_user_id, client_user_id])
}

model notification_deliveries {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notification_event_id String?                      @db.Uuid
  user_id               String?                      @db.Uuid
  channel               notification_channel
  delivery_status       notification_delivery_status
  provider_message_id   String?
  delivered_at          DateTime?                    @db.Timestamptz(6)
  created_at            DateTime                     @default(now()) @db.Timestamptz(6)
  notification_events   notification_events?         @relation(fields: [notification_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notification_events {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type              String
  payload                 Json
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  notification_deliveries notification_deliveries[]
}

model notification_preferences {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String?                @db.Uuid
  user_id            String?                @db.Uuid
  channel            notification_channel
  destination        String
  language_code      String?                @default("en")
  frequency          notification_frequency @default(important_only)
  opted_in           Boolean                @default(true)
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  languages          languages?             @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions?    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, channel, destination])
  @@unique([session_id, channel, destination])
}

model organizations {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  organization_type  String
  phone              String?
  email              String?     @db.Citext
  website_url        String?
  address            Json?
  service_categories String[]    @default([])
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  referrals          referrals[]
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique
  description      String?
  role_permissions role_permissions[]
}

model program_document_requirements {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id       String         @db.Uuid
  document_type_id String         @db.Uuid
  condition_json   Json?          @default("{}")
  is_required      Boolean        @default(true)
  document_types   document_types @relation(fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs         programs       @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([program_id, document_type_id])
}

model program_life_events {
  program_id    String      @db.Uuid
  life_event_id String      @db.Uuid
  life_events   life_events @relation(fields: [life_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programs      programs    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([program_id, life_event_id])
}

model program_translations {
  program_id        String    @db.Uuid
  language_code     String
  name              String
  short_description String
  next_steps        String
  languages         languages @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  programs          programs  @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([program_id, language_code])
}

model programs {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_key                   String                          @unique
  category                      String
  authoritative_url             String
  is_active                     Boolean                         @default(true)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  search_vector                 Unsupported("tsvector")?
  benefit_estimates             benefit_estimates[]
  eligibility_results           eligibility_results[]
  eligibility_rule_versions     eligibility_rule_versions[]
  knowledge_sources             knowledge_sources[]
  program_document_requirements program_document_requirements[]
  program_life_events           program_life_events[]
  program_translations          program_translations[]
  session_document_checklist    session_document_checklist[]

  @@index([search_vector], type: Gin)
}

model question_dependencies {
  id                                                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id                                                       String    @db.Uuid
  depends_on_question_id                                            String    @db.Uuid
  condition_json                                                    Json
  questions_question_dependencies_depends_on_question_idToquestions questions @relation("question_dependencies_depends_on_question_idToquestions", fields: [depends_on_question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions_question_dependencies_question_idToquestions            questions @relation("question_dependencies_question_idToquestions", fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model question_translations {
  question_id   String    @db.Uuid
  language_code String
  prompt        String
  helper_text   String?
  languages     languages @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  questions     questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([question_id, language_code])
}

model questions {
  id                                                                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_key                                                                  String                  @unique
  answer_type                                                                   String
  display_order                                                                 Int
  is_required                                                                   Boolean                 @default(true)
  branching_config                                                              Json?                   @default("{}")
  created_at                                                                    DateTime                @default(now()) @db.Timestamptz(6)
  answer_options                                                                answer_options[]
  question_dependencies_question_dependencies_depends_on_question_idToquestions question_dependencies[] @relation("question_dependencies_depends_on_question_idToquestions")
  question_dependencies_question_dependencies_question_idToquestions            question_dependencies[] @relation("question_dependencies_question_idToquestions")
  question_translations                                                         question_translations[]
  screening_answers                                                             screening_answers[]
}

model referrals {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String             @db.Uuid
  organization_id    String?            @db.Uuid
  need_category      String
  status             referral_status    @default(draft)
  notes              String?
  sent_at            DateTime?          @db.Timestamptz(6)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  organizations      organizations?     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model resume_tokens {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String             @db.Uuid
  channel            auth_channel
  destination        String
  token_hash         String
  expires_at         DateTime           @db.Timestamptz(6)
  used_at            DateTime?          @db.Timestamptz(6)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  screening_sessions screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resume_session")

  @@index([token_hash], map: "idx_resume_tokens_hash")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique
  description      String?
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model screening_answers {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String             @db.Uuid
  question_id        String             @db.Uuid
  answer_value       Json
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  questions          questions          @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, question_id])
  @@index([session_id], map: "idx_screening_answers_session")
  @@index([answer_value], map: "idx_screening_answers_value", type: Gin)
}

model screening_sessions {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String?                      @db.Uuid
  preferred_language         String?                      @default("en")
  current_step               Int?                         @default(0)
  completed_at               DateTime?                    @db.Timestamptz(6)
  expires_at                 DateTime?                    @db.Timestamptz(6)
  ip_address                 String?                      @db.Inet
  user_agent                 String?
  fingerprint_hash           String?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  addresses                  addresses[]
  ai_conversations           ai_conversations[]
  ai_recommendations         ai_recommendations[]
  anomaly_flags              anomaly_flags[]
  audit_logs                 audit_logs[]
  benefit_estimates          benefit_estimates[]
  cases                      cases[]
  document_uploads           document_uploads[]
  eligibility_results        eligibility_results[]
  notification_preferences   notification_preferences[]
  referrals                  referrals[]
  resume_tokens              resume_tokens[]
  screening_answers          screening_answers[]
  search_queries             search_queries[]
  languages                  languages?                   @relation(fields: [preferred_language], references: [code], onDelete: NoAction, onUpdate: NoAction)
  users                      users?                       @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  session_document_checklist session_document_checklist[]

  @@index([fingerprint_hash])
}

model session_document_checklist {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String             @db.Uuid
  program_id         String?            @db.Uuid
  document_type_id   String             @db.Uuid
  reason             Json?              @default("{}")
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  document_types     document_types     @relation(fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programs           programs?          @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions screening_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, program_id, document_type_id])
}

model user_roles {
  user_id String @db.Uuid
  role_id String @db.Uuid
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model user_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?   @db.Uuid
  refresh_token_hash String
  ip_address         String?   @db.Inet
  user_agent         String?
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                                           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                        String?                     @unique @db.Citext
  phone                                                        String?                     @unique
  preferred_language                                           String?                     @default("en")
  role                                                         user_role                   @default(resident)
  auth_user_id                                                 String?                     @unique @db.Uuid
  created_at                                                   DateTime                    @default(now()) @db.Timestamptz(6)
  addresses                                                    addresses[]
  ai_conversations                                             ai_conversations[]
  ai_recommendations                                           ai_recommendations[]
  anomaly_flags_anomaly_flags_reviewed_byTousers               anomaly_flags[]             @relation("anomaly_flags_reviewed_byTousers")
  anomaly_flags_anomaly_flags_user_idTousers                   anomaly_flags[]             @relation("anomaly_flags_user_idTousers")
  audit_logs                                                   audit_logs[]
  case_notes                                                   case_notes[]
  cases                                                        cases[]
  document_classifications                                     document_classifications[]
  eligibility_rule_versions                                    eligibility_rule_versions[]
  navigator_clients_navigator_clients_client_user_idTousers    navigator_clients[]         @relation("navigator_clients_client_user_idTousers")
  navigator_clients_navigator_clients_navigator_user_idTousers navigator_clients[]         @relation("navigator_clients_navigator_user_idTousers")
  notification_deliveries                                      notification_deliveries[]
  notification_preferences                                     notification_preferences[]
  screening_sessions                                           screening_sessions[]
  search_queries                                               search_queries[]
  user_roles                                                   user_roles[]
  user_sessions                                                user_sessions[]
  languages                                                    languages?                  @relation(fields: [preferred_language], references: [code], onDelete: NoAction, onUpdate: NoAction)
  auth_user                                                    User?                       @relation(fields: [auth_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

// ---------------------------------------------------------------------------
// AI features: semantic search, document classification, recommendations,
// anomaly detection (user stories 14–17).
// Note: search_embeddings uses pgvector. Requires `CREATE EXTENSION vector;`
// and an HNSW index added via raw SQL migration (Prisma doesn't model HNSW).
// ---------------------------------------------------------------------------

model ai_recommendations {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String?                    @db.Uuid
  user_id            String?                    @db.Uuid
  target_type        recommendation_target_type
  target_id          String                     @db.Uuid
  rationale          String?
  score              Decimal?                   @db.Decimal(4, 3)
  model_name         String?
  status             recommendation_status      @default(pending)
  viewed_at          DateTime?                  @db.Timestamptz(6)
  accepted_at        DateTime?                  @db.Timestamptz(6)
  dismissed_at       DateTime?                  @db.Timestamptz(6)
  created_at         DateTime                   @default(now()) @db.Timestamptz(6)
  screening_sessions screening_sessions?        @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?                     @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([session_id, target_type, target_id])
  @@index([session_id, status])
  @@index([target_type, target_id])
}

model anomaly_flags {
  id                                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id                             String?             @db.Uuid
  user_id                                String?             @db.Uuid
  flag_type                              anomaly_flag_type
  severity                               anomaly_severity    @default(low)
  status                                 anomaly_status      @default(open)
  detector                               String?
  payload                                Json                @default("{}")
  reviewed_by                            String?             @db.Uuid
  reviewed_at                            DateTime?           @db.Timestamptz(6)
  review_notes                           String?
  created_at                             DateTime            @default(now()) @db.Timestamptz(6)
  users_anomaly_flags_reviewed_byTousers users?              @relation("anomaly_flags_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions                     screening_sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users_anomaly_flags_user_idTousers     users?              @relation("anomaly_flags_user_idTousers", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([session_id])
  @@index([status, severity, created_at(sort: Desc)])
  @@index([payload], type: Gin)
}

model document_classifications {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_upload_id   String                @db.Uuid
  document_type_id     String?               @db.Uuid
  confidence           Decimal?              @db.Decimal(4, 3)
  classified_by        classification_source
  model_name           String?
  corrected_by_user_id String?               @db.Uuid
  raw_response         Json?
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  users                users?                @relation(fields: [corrected_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  document_types       document_types?       @relation(fields: [document_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_uploads     document_uploads      @relation(fields: [document_upload_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_upload_id, created_at(sort: Desc)])
}

model search_embeddings {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type     search_target_type
  target_id       String                      @db.Uuid
  language_code   String
  content_text    String
  embedding       Unsupported("vector(1536)")
  embedding_model String
  created_at      DateTime                    @default(now()) @db.Timestamptz(6)
  languages       languages                   @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([target_type, target_id, language_code, embedding_model])
  @@index([target_type, language_code])
}

model search_queries {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id           String?             @db.Uuid
  user_id              String?             @db.Uuid
  query_text           String
  language_code        String?
  result_count         Int?
  selected_target_type search_target_type?
  selected_target_id   String?             @db.Uuid
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  languages            languages?          @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  screening_sessions   screening_sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users                users?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([session_id])
}

model search_synonyms {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  language_code String
  term          String
  synonyms      String[]  @default([])
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  languages     languages @relation(fields: [language_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([language_code, term])
}

